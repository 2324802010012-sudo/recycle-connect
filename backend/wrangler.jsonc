
{
  "name": "recycle-connect-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-19",
  "ratelimits": [
    {
      "name": "LOGIN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "assets": {
    "directory": "../frontend/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recycle-connect-db",
      "database_id": "5b4a7a63-73fe-4614-900e-31fec2e455e2"
    }
  ]
}
